# Copy to .env (gitignored) and fill in. Scale's CLI finds .env by walking up from vendor/hil-bench.
OPENROUTER_API_KEY=
# Required by Scale's harness: every LiteLLM call is tagged with this user string.
LITELLM_USER=
# Only for the Gemini checks (configs/sql/gemini31pro_*.yaml); not needed for the experiments below.
GEMINI_API_KEY=
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global
